{
    "name": "yosida001/qoo10-sdk",
    "description": "PHP SDK for the Qoo10 Japan API.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "qoo10",
        "qoo10-api",
        "sdk"
    ],
    "homepage": "https://github.com/yosida001/qoo10-sdk",
    "support": {
        "issues": "https://github.com/yosida001/qoo10-sdk/issues",
        "source": "https://github.com/yosida001/qoo10-sdk"
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.idea",
            "/.phpunit.result.cache",
            "/.tool-versions",
            "/Dockerfile",
            "/Makefile",
            "/composer.lock",
            "/docker-compose.yml",
            "/phpunit.xml.dist",
            "/tests",
            "/vendor"
        ]
    },
    "require": {
        "php": "^7.2",
        "guzzlehttp/guzzle": "^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Yosida001\\Qoo10Sdk\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Yosida001\\Qoo10Sdk\\Tests\\": "tests/"
        }
    }
}
